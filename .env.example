# Copy to .env (repo root, for docker/tooling) and/or apps/api/.env, apps/web/.env.local
# Never commit real values. All secrets are read from environment variables only.

# ── App ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────
# Defaults to a local SQLite file (no setup required) so Phase 7 research
# persistence works out of the box. Point this at a Postgres/Supabase URL
# for anything beyond solo local development, e.g.:
#   postgresql+psycopg://postgres:postgres@localhost:5432/ai_market_desk
DATABASE_URL=sqlite:///./ai_market_desk.db

# ── Market Data Provider ─────────────────────────────────────────────────
# "yfinance" (default): no account/key needed, research/development data
#   only — see docs/decisions/0006-yfinance-development-provider.md.
# "alpaca": requires an eligible account holder's credentials below.
# "massive": requires MASSIVE_API_KEY below — see
#   docs/decisions/0018-streaming-market-data-provider.md. The only
#   provider here that genuinely pushes trades/quotes/aggregates over a
#   persistent WebSocket; a missing key falls back to REST polling honestly
#   labeled as such, never a silent "real-time" claim.
MARKET_DATA_PROVIDER=yfinance

# ── Alpaca Market Data (only used when MARKET_DATA_PROVIDER=alpaca) ────────
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_PAPER=true

# ── Massive Market Data (only used when MARKET_DATA_PROVIDER=massive) ─────
# Never commit a real key. Requires an "Advanced" tier (or above) Massive
# plan for real-time (non-15-min-delayed) streaming access.
MASSIVE_API_KEY=
MASSIVE_REST_BASE_URL=https://api.massive.com
MASSIVE_WS_URL=wss://socket.massive.com/stocks

# ── OpenAI ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Scheduling ───────────────────────────────────────────────────────────
# Shared secret the GitHub Actions scheduler sends so scan endpoints can't be
# triggered by anyone who finds the URL.
SCHEDULER_SHARED_SECRET=
REPORT_TIMEZONE=America/New_York

# ── Frontend (apps/web) ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
