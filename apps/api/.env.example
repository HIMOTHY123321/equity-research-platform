# Copy to .env and fill in real values. Never commit .env with real secrets.
# See app/config.py for the authoritative field list, defaults, and
# production fail-fast validation rules.

# App
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Session signing (REQUIRED in production -- generate with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=1440

# Database (SQLite default for local dev/test only -- production MUST use
# Postgres, e.g. postgresql+psycopg://user:password@host:5432/dbname)
DATABASE_URL=sqlite:///./ai_market_desk.db

# Market data provider: yfinance (dev/research only, never production) |
# alpaca | massive
MARKET_DATA_PROVIDER=yfinance
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_PAPER=true
MASSIVE_API_KEY=
MASSIVE_REST_BASE_URL=https://api.massive.com
MASSIVE_WS_URL=wss://socket.massive.com/stocks
# Phase 17: explicit, operator-set confirmation that the Massive account
# above actually carries real-time streaming entitlement -- a valid key
# alone is never sufficient proof (see docs/decisions/0021 and the
# "Activating a licensed real-time provider" section of docs/deployment.md).
# Unset (default) = unknown, never assumed true. true | false | unset.
MASSIVE_STREAMING_ENTITLED=

# Phase 17: dev-only trigger for app.live.mock_streaming.MockStreamingProvider
# (/api/dev/live-simulator, /dev/live-simulator) -- lets a developer preview
# live-chart UX without a real provider account. MUST stay false in any
# production-adjacent environment; the app refuses to start with
# ENVIRONMENT=production and this set to true.
ENABLE_DEV_LIVE_SIMULATOR=false

# News provider: yfinance (dev/research only, never production) | fixture
NEWS_PROVIDER=yfinance

# AI Research Analyst provider: mock (default, no credentials) | openai
AI_ANALYSIS_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Scheduling
SCHEDULER_SHARED_SECRET=
REPORT_TIMEZONE=America/New_York
