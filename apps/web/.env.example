# Base URL the browser (and this app's own server-side code) uses to reach
# the FastAPI backend. Defaults to local dev if unset.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Phase 16.1: MUST match the backend's SECRET_KEY (apps/api/.env.example)
# exactly -- proxy.ts verifies the session cookie's JWT signature locally
# (fast, no DB round trip) using this same secret. Both default to the
# same obviously-fake development placeholder so local dev needs no extra
# configuration; production MUST override both to the same real secret.
SESSION_JWT_SECRET=insecure-development-secret-do-not-use-in-production
